generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  displayName  String
  level        Int      @default(1)
  xp           Int      @default(0)
  cashBalance  Float    @default(10000)
  riskProfile  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  holdings     Holding[]
  transactions Transaction[]
  userMissions UserMission[]
  userBadges   UserBadge[]
  chatMessages ChatMessage[]
  appSetting   AppSetting?
}

model Asset {
  id         String  @id @default(cuid())
  ticker     String  @unique
  name       String
  type       String
  basePrice  Float
  volatility Float

  priceTicks   PriceTick[]
  holdings     Holding[]
  transactions Transaction[]
}

model PriceTick {
  id        String   @id @default(cuid())
  assetId   String
  price     Float
  timestamp DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@index([assetId, timestamp(sort: Desc)])
}

model Holding {
  id           String @id @default(cuid())
  userId       String
  assetId      String
  quantity     Float
  avgBuyPrice  Float

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([userId, assetId])
}

model Transaction {
  id        String   @id @default(cuid())
  userId    String
  assetId   String
  type      String
  quantity  Float
  price     Float
  timestamp DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Mission {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String
  difficulty  String
  xpReward    Int
  goalType    String
  goalParams  String

  userMissions UserMission[]
}

model UserMission {
  id          String    @id @default(cuid())
  userId      String
  missionId   String
  status      String
  progress    String    @default("{}")
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([userId, missionId])
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  icon        String

  userBadges UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AppSetting {
  id              String @id @default(cuid())
  userId          String @unique
  provider        String
  apiKeyEncrypted String
  model           String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
