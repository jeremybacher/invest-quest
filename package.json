{
  "name": "invest-quest",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/eslint/bin/eslint.js . --ext .ts,.tsx",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "db:seed": "node_modules/.bin/tsx prisma/seed.ts",
    "db:reset": "rm -f prisma/dev.db prisma/dev.db-journal && node_modules/.bin/prisma migrate deploy && npm run db:seed"
  },
  "prisma": {
    "seed": "node_modules/.bin/tsx prisma/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
